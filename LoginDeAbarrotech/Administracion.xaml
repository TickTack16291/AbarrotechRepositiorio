<Window x:Class="LoginDeAbarrotech.Administracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Administración" Height="680" Width="1300" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1565C0" Offset="0"/>
                <GradientStop Color="#1565C0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="Panel de Administración" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- TabControl -->
                <TabControl Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                    <!-- Tab Ventas -->
                    <TabItem Header="Ventas" FontSize="14" FontWeight="SemiBold">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Registro de Ventas" FontSize="16" FontWeight="Bold" 
                                       Foreground="#1565C0" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" x:Name="dg_Ventas" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      BorderBrush="#E0E0E0" BorderThickness="1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No. Venta" Binding="{Binding id_venta}" Width="100"/>
                                    <DataGridTextColumn Header="No. Usuario" Binding="{Binding id_usuario}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding fecha_venta, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding total_venta, StringFormat=C2}" Width="120"/>
                                    <DataGridTextColumn Header="Forma de Pago" Binding="{Binding forma_pago_venta}" Width="150"/>
                                    <DataGridTextColumn Header="Caja" Binding="{Binding caja}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab Compras -->
                    <TabItem Header="Compras" FontSize="14" FontWeight="SemiBold">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Registro de Compras" FontSize="16" FontWeight="Bold" 
                                       Foreground="#1565C0" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" x:Name="dg_Compras" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      BorderBrush="#E0E0E0" BorderThickness="1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No. Compra" Binding="{Binding id_compra}" Width="100"/>
                                    <DataGridTextColumn Header="No. Usuario" Binding="{Binding id_usuario}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding fecha_compra, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding total_compra, StringFormat=C2}" Width="120"/>
                                    <DataGridTextColumn Header="Forma de Pago" Binding="{Binding forma_pago_compra}" Width="150"/>
                                    <DataGridTextColumn Header="Caja" Binding="{Binding caja}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab Transacciones -->
                    <TabItem Header="Transacciones" FontSize="14" FontWeight="SemiBold">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Historial de Transacciones" FontSize="16" FontWeight="Bold" 
                                       Foreground="#1565C0" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" x:Name="dg_Transacciones" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      BorderBrush="#E0E0E0" BorderThickness="1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No." Binding="{Binding id_transaccion}" Width="80"/>
                                    <DataGridTextColumn Header="No. Inventario" Binding="{Binding id_inventario}" Width="100"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding tipo_movimiento_transaccion}" Width="120"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad_modificada_transaccion}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding fecha_registro_salida_transaccion, StringFormat=dd/MM/yyyy HH:mm}" Width="180"/>
                                    <DataGridTextColumn Header="No. Venta" Binding="{Binding id_venta}" Width="100"/>
                                    <DataGridTextColumn Header="No. Compra" Binding="{Binding id_compra}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab Inventario -->
                    <TabItem Header="Inventario" FontSize="14" FontWeight="SemiBold">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Estado del Inventario" FontSize="16" FontWeight="Bold" 
                                       Foreground="#1565C0" Margin="0,0,0,10"/>

                            <DataGrid Grid.Row="1" x:Name="dg_Inventario" AutoGenerateColumns="False"
                                      IsReadOnly="True" HeadersVisibility="Column"
                                      BorderBrush="#E0E0E0" BorderThickness="1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No. Inventario" Binding="{Binding id_inventario}" Width="110"/>
                                    <DataGridTextColumn Header="No. Producto" Binding="{Binding id_producto}" Width="100"/>
                                    <DataGridTextColumn Header="Código Barras" Binding="{Binding codigo_barras_inventario}" Width="180"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad_inventario}" Width="100"/>
                                    <DataGridTextColumn Header="Ubicación" Binding="{Binding ubicacion_inventario}" Width="150"/>
                                    <DataGridTextColumn Header="F. Elaboración" Binding="{Binding fecha_elaboracion, StringFormat=dd/MM/yyyy}" Width="135"/>
                                    <DataGridTextColumn Header="F. Caducidad" Binding="{Binding fecha_caducidad, StringFormat=dd/MM/yyyy}" Width="135"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Botones -->
                <Grid Grid.Row="2" Margin="0,15,0,0">
                    <Button x:Name="btn_Cerrar" Content="Cerrar" Background="#E53935" Foreground="White"
                            Height="40" Width="120" FontWeight="Bold" 
                            HorizontalAlignment="Center"
                            Click="btn_Cerrar_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>