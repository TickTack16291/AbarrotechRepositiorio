<Window x:Class="LoginDeAbarrotech.Configuracion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configuración de Usuario" Height="742" Width="450"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botones -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A3A82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#616161"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20">
            <StackPanel>
                <TextBlock Text="⚙️ Configuración de Usuario" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="txt_CurrentUser" 
                           Text="Usuario actual" 
                           FontSize="14" 
                           Foreground="#E3F2FD" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"/>
                <Label x:Name="Lbl_mensaje" Foreground="Red" Visibility="Hidden" Content="El usuario ya existe o no ha cambiado" HorizontalContentAlignment="Center" RenderTransformOrigin="-1.009,2.654" Width="384"/>

            </StackPanel>
            
        </Border>


        <!-- Contenido principal -->
        <Border Grid.Row="1" Padding="30,20" Background="White" Margin="15,15,15,0">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2" BlurRadius="10" Color="#40000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Sección de cambio de usuario -->
                <TextBlock Text="Cambiar Usuario" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#1565C0" 
                           Margin="0,0,0,10"/>

                <TextBlock Text="Nuevo usuario:" 
                           FontSize="13" 
                           Foreground="#666666" 
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txt_NuevoUsuario" 
                         Style="{StaticResource ModernTextBox}" 
                         Margin="0,0,0,20"/>

                <!-- Separador -->
                <Border Height="1" Background="#E0E0E0" Margin="0,10,0,20"/>

                <!-- Sección de cambio de contraseña -->
                <TextBlock Text="Cambiar Contraseña" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#1565C0" 
                           Margin="0,0,0,10"/>

                <TextBlock Text="Contraseña actual:" 
                           FontSize="13" 
                           Foreground="#666666" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="pwd_Actual" 
                             Style="{StaticResource ModernPasswordBox}" 
                             Margin="0,0,0,15"/>

                <TextBlock Text="Nueva contraseña:" 
                           FontSize="13" 
                           Foreground="#666666" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="pwd_Nueva" 
                             Style="{StaticResource ModernPasswordBox}" 
                             Margin="0,0,0,15"/>

                <TextBlock Text="Confirmar nueva contraseña:" 
                           FontSize="13" 
                           Foreground="#666666" 
                           Margin="0,0,0,5"/>
                <PasswordBox x:Name="pwd_Confirmar" 
                             Style="{StaticResource ModernPasswordBox}" 
                             Margin="0,0,0,10"/>

                <!-- Botones de acción -->
                <UniformGrid Columns="2" Margin="0,20,0,0">
                    <Button Content="Guardar Cambios" 
                            Style="{StaticResource ModernButton}" 
                            Margin="0,0,10,0" 
                            Click="btn_GuardarCambios_Click"/>
                    <Button Content="Cancelar" 
                            Style="{StaticResource CancelButton}" 
                            Margin="10,0,0,0" 
                            Background="Red"
                            Click="btn_Cancelar_Click"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
