<Window x:Class="LoginDeAbarrotech.DatosProducto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="Datos del Producto" Height="500" Width="600" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1565C0" Offset="0"/>
                <GradientStop Color="#1565C0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="520" Height="464"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nombre del producto -->
                    <RowDefinition Height="*"/>
                    <!-- Formulario -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Título -->
                <TextBlock Grid.Row="0" Text="Datos del Producto" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <!-- Información del producto -->
                <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,0,0,20"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="txt_NombreProducto" FontSize="16" FontWeight="Bold" 
                                   Foreground="#424242" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Formulario -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Código de barras -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="Código de Barras" Foreground="#424242" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <TextBox x:Name="txt_CodigoBarras" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2" FontSize="14"
                                 ToolTip="Ingrese el código de barras del producto"/>
                    </StackPanel>

                    <!-- Fecha de elaboración -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Fecha de Elaboración" Foreground="#424242" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dp_FechaElaboracion" Height="45" Padding="10"
                                    BorderBrush="#1976D2" BorderThickness="2" FontSize="14"
                                    ToolTip="Seleccione la fecha de elaboración del producto"/>
                    </StackPanel>

                    <!-- Fecha de caducidad -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Fecha de Caducidad" Foreground="#424242" Margin="5,0,0,5" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dp_FechaCaducidad" Height="45" Padding="10"
                                    BorderBrush="#1976D2" BorderThickness="2" FontSize="14"
                                    ToolTip="Seleccione la fecha de caducidad del producto"/>
                    </StackPanel>
                </Grid>

                <!-- Mensaje de error -->
                <Label x:Name="Lbl_mensaje" Grid.Row="1"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Foreground="Red" FontWeight="Bold"
                       Content="No puede haber campos vacios"
                       Visibility="Hidden" Margin="122,0,0,12"/>

                <!-- Botones -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                            Height="45" Width="180" FontWeight="Bold" 
                            HorizontalAlignment="Right" Margin="0,0,10,0" Grid.Column="0"
                            Click="btn_Cancelar_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D32F2F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="btn_Aceptar" Content="Aceptar" Background="#4CAF50" Foreground="White"
                            Height="45" Width="180" FontWeight="Bold" 
                            HorizontalAlignment="Left" Grid.Column="1"
                            Click="btn_Aceptar_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#45A049"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>