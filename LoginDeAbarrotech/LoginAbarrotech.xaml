<Window x:Class="LoginDeAbarrotech.LoginAbarrotech"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="LoginAbarrotech" Height="680" Width="850"  WindowStartupLocation="CenterScreen">

    <!-- Grid es el contenedor principal que organiza los elementos -->
    <Grid x:Name="Login_Abarrotech" Margin="0,0,0,-6">
        <!-- Fondo blanco sólido -->
        <Grid.Background>
            <SolidColorBrush Color="White"/>
        </Grid.Background>

        <!--Contenedor azul para los componentes-->
        <Border Background="#1565C0" CornerRadius="20" Padding="35" Width="400" Height="520"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <!--Con border effect damos la sensacion de una sombra -->
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="20" ShadowDepth="8" Opacity="0.5"/>
            </Border.Effect>
            <!-- StackPanel organiza los elementos como una lista uno debajo del otro-->
            <StackPanel>

                <StackPanel>
                    <!--Viewbox hace que el contenido se escale automaticamente-->
                    <Viewbox Width="70" Height="70" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Canvas Width="24" Height="24">
                            <Ellipse Fill="White" Width="6" Height="6" Canvas.Left="5" Canvas.Top="16"/>
                            <Ellipse Fill="White" Width="6" Height="6" Canvas.Left="15" Canvas.Top="16"/>
                            <Path Data="M2,2 L4,2 L6,12 L18,12 L20,6 L7,6"
                              Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="AbarroTech" FontSize="26" FontWeight="Bold" 
                           Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                </StackPanel>

                <!-- Cajas de texto para datos -->
                <TextBlock Text="Usuario" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,5" FontSize="13"/>
                <TextBox x:Name="txtUsuario" Margin="0,0,0,18" Height="45" Padding="12"
                     BorderBrush="White" BorderThickness="2" Background="White" Foreground="#1565C0"
                     FontSize="14">
                    <!-- Style - Define el aspecto visual del control , TargetType="TextBox" aplica este estilo a todos los TextBox-->
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <!-- ControlTemplate es como una plantilla para que todos nuestros elementos se vean iguales-->
                                    <ControlTemplate TargetType="TextBox">
                                        <Border CornerRadius="8" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}">
                                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!--Contraseña 
                password box es lo mismo que textbox solo que oculta los caracteres al ser una contraseña-->
                <TextBlock Text="Contraseña" Foreground="White" FontWeight="SemiBold" Margin="5,0,0,5" FontSize="13"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,15" Height="45" Padding="12"
                         BorderBrush="White" BorderThickness="2" Background="White" Foreground="#1565C0"
                         FontSize="14">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border CornerRadius="8" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Background="{TemplateBinding Background}">
                                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                
                <Label Name="Lbl_error" 
                       HorizontalAlignment="Center" 
                       Foreground="#FFEBEE" 
                       Background="#D32F2F"
                       Content="Usuario o contraseña inválidos" 
                       Visibility="Hidden"
                       Padding="10,5"
                       FontWeight="SemiBold"
                       FontSize="12">
                    <Label.Style>
                        <Style TargetType="Label">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Label">
                                        <Border CornerRadius="6" 
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Label.Style>
                </Label>

                <!--Botones-->
                <StackPanel Orientation="Vertical" Margin="0,15,0,12">
                    <Button x:Name="btnLogin" Content="Ingresar" Background="White" Foreground="#1565C0"
                        Height="45" FontWeight="Bold" FontSize="14" Click="btnLogin_Click" IsDefault="True">
                        <!-- EL IsDefault = "True" es para que el evento del boton "Ingresar" tambien se active con el "enter"-->
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </Button.Style>

                        <!-- Triggers definen animaciones cuando ocurren eventos -->
                        <!-- Animacion cuando el mouse entra al boton -->
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                    To="#E3F2FD" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                    To="White" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                </StackPanel>
                
                <Button x:Name="btn_Cerrar" Content="Salir" Background="#D32F2F" Foreground="White"
                    Height="38" Width="110" FontWeight="SemiBold" Click="btn_Cerrar_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </Button.Style>
                    
                    <!-- Animación hover para botón salir -->
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                To="#B71C1C" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                To="#D32F2F" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>
                <!-- Botón pequeño para cerrar -->
            </StackPanel>
        </Border>
    </Grid>
</Window>
