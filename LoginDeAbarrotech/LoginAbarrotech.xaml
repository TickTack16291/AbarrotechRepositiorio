<Window x:Class="LoginDeAbarrotech.LoginAbarrotech"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="LoginAbarrotech" Height="680" Width="850"  WindowStartupLocation="CenterScreen">

    <!-- Grid es el contenedor principal que organiza los elementos -->
    <Grid x:Name="Login_Abarrotech" Margin="0,0,0,-6">
        <!-- Fondo degradado azul -->
        <Grid.Background>
            <!-- 
                LinearGradientBrush -Crea un fondo con degradado de colores
                StartPoint="0,0" es el punto inicial donde queremos el degradadp en este caso la esquina izquierda
                EndPoint="0,1" - es el punto dinal del degradado, la esquina de abajo derecha
                -->
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <!--Con los valores de gradient podemos modificar que tan degradado es el fondo-->
                <GradientStop Color="#1976D2" Offset="2.5"/>
                <GradientStop Color="#42A5F5" Offset="5.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!--Contenedor blanco para los componentes-->
        <Border Background="White" CornerRadius="20" Padding="30" Width="380" Height="484"
            HorizontalAlignment="Center" VerticalAlignment="Center">
            <!--Con border effect damos la sensacion de una sombra -->
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>
            <!-- StackPanel organiza los elementos comoua lista uno debajo del otro-->
            <StackPanel>

                <StackPanel>
                    <!--Viewbox hace que el contenido se escale automaticamente-->
                    <Viewbox Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Canvas Width="24" Height="24">
                            <Ellipse Fill="#1976D2" Width="6" Height="6" Canvas.Left="5" Canvas.Top="16"/>
                            <Ellipse Fill="#1976D2" Width="6" Height="6" Canvas.Left="15" Canvas.Top="16"/>
                            <Path Data="M2,2 L4,2 L6,12 L18,12 L20,6 L7,6"
                              Stroke="#1976D2" StrokeThickness="2" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="AbarroTech" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Cajas de texto para datos -->
                <TextBlock Text="Usuario" Foreground="#424242" Margin="5,0,0,3"/>
                <TextBox x:Name="txtUsuario" Margin="0,0,0,15" Height="43" Padding="10"
                     BorderBrush="#1976D2" BorderThickness="2">
                    <!-- Style - Define el aspecto visual del control , TargetType="TextBox" aplica este estilo a todos los TextBox-->
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">

                                <Setter.Value>
                                    <!-- ControlTemplate es como una plantilla para que todos nuestros elementos se vean iguales-->
                                    <!-- 
                                            Border - Crea el borde redondeado
                                            CornerRadius="8" - Bordes redondeados
                                            TemplateBinding - Enlaza con las propiedades del TextBox original
                                            ScrollViewer - Permite scroll si el texto es muy largo
                                            -->
                                    <ControlTemplate TargetType="TextBox">
                                        <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <!--Contraseña 
                password box es lo mismo que textbox solo que oculta los caracteres al ser una contraseña-->
                <TextBlock Text="Contraseña" Foreground="#424242" Margin="5,0,0,3"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,20" Height="40" Padding="10"
                         BorderBrush="#1976D2" BorderThickness="2">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">

                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="PasswordBox">
                                        <Border CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>
                <Label Name="Lbl_error" HorizontalAlignment="Center" Foreground="Red" Content="Usuario o contraseña invalidos" Visibility="Hidden"></Label>

                <!--Botones-->
                <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                    <Button x:Name="btnLogin" Content="Ingresar" Background="#1976D2" Foreground="White"
                        Height="40" FontWeight="Bold" Click="btnLogin_Click" IsDefault="True">
                        <!-- EL IsDefault = "True" es para que el evento del boton "Ingresar" tambien se active con el "enter"-->
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                        <!-- Triggers definen animaciones cuando ocurren eventos -->
                        <!-- Animacion cuando el mouse entra al boton -->
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                    To="#1565C0" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetProperty="(Control.Background).(SolidColorBrush.Color)"
                                                    To="#1976D2" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                    </Button>

                </StackPanel>
                <Button x:Name="btn_Cerrar" Content="Salir" Background="#E53935" Foreground="White"
                    Height="34" Width="100" Click="btn_Cerrar_Click" RenderTransformOrigin="0.55,2.319">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Label x:Name="Lbl_registroUsuario" Foreground="Blue" Content="Registrarse..." HorizontalContentAlignment="Center" MouseLeftButtonDown="Lbl_registroUsuario_MouseLeftButtonDown"/>

                <!-- BotOns pequeño para cerrar -->
            </StackPanel>
        </Border>
    </Grid>
</Window>
