<Window x:Class="LoginDeAbarrotech.RegistroEmpleados"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroEmpleados" Height="680" Width="1300" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="0"/>
                <GradientStop Color="#42A5F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <!-- Layout principal: Título, Formulario, Tabla, Botones -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="Auto"/>
                    <!-- Formulario -->
                    <RowDefinition Height="*"/>
                    <!-- Tabla -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Registro de Empleados" FontSize="22" FontWeight="Bold" 
                               Foreground="#1565C0" HorizontalAlignment="Center"/>
                    <Label x:Name="Lbl_mensaje"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="Green"
                           Content="Empleado agregado correctamente"
                           Visibility="Hidden"/>
                </Grid>

                <!-- Formulario (sin ScrollViewer) -->
                <Grid Grid.Row="1" Margin="0,20,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fila 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,0,10,10">
                        <TextBlock Text="Nombre" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_NombreEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,10">
                        <TextBlock Text="Dirección" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_DireccionEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,10,10">
                        <TextBlock Text="Teléfono" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_TelefonoEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="10,0,10,10">
                        <TextBlock Text="Correo Electrónico" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_CorreoEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Fila 2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,0,10,10">
                        <TextBlock Text="Rol" Foreground="#424242" Margin="5,0,0,3"/>
                        <!-- Cambiado a ComboBox con roles típicos de tienda de abarrotes -->
                        <ComboBox x:Name="ct_RolEmpleado" Height="45" Padding="10"
                                  BorderBrush="#1976D2" BorderThickness="2" IsEditable="False">
                            <ComboBoxItem Content="Gerente"/>
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Vendedor"/>
                            <ComboBoxItem Content="Reponedor"/>
                            <ComboBoxItem Content="Encargado de inventario"/>
                            <ComboBoxItem Content="Limpieza"/>
                            <ComboBoxItem Content="Seguridad"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,10">
                        <TextBlock Text="Salario" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_SalarioEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,0,10,10">
                        <TextBlock Text="Fecha de Contrato" Foreground="#424242" Margin="5,0,0,3"/>
                        <DatePicker x:Name="dp_FechaContrato" Height="45"
                                    BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="3" Margin="10,0,10,10">
                        <TextBlock Text="Estado" Foreground="#424242" Margin="5,0,0,3"/>
                        <ComboBox x:Name="cb_EstadoEmpleado" Height="45" Padding="10"
                                  BorderBrush="#1976D2" BorderThickness="2">
                                <ComboBoxItem Content="Activo"/>
                                <ComboBoxItem Content="Inactivo"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Fila 3 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="10,0,10,0">
                        <TextBlock Text="Hora de Entrada" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_HoraEntrada" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Hora de Salida" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_HoraSalida" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="10,0,10,0">
                        <TextBlock Text="Fecha Fin de Contrato" Foreground="#424242" Margin="5,0,0,3"/>
                        <DatePicker x:Name="dp_FechaFinContrato" Height="45"
                                    BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>
                </Grid>

                <!-- Tabla de empleados -->
                <Border Grid.Row="2"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Padding="10">
                    <Grid>
                        <TextBlock Text="Lista de Empleados" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,8" VerticalAlignment="Top"/>

                        <DataGrid x:Name="dg_Empleados" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0,30,0,0"
                                  SelectionChanged="dg_Empleados_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id_empleado}" Width="60"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding nombre_empleado}" Width="150"/>
                                <DataGridTextColumn Header="Dirección" Binding="{Binding direccion_empleado}" Width="150"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding telefono_empleado}" Width="100"/>
                                <DataGridTextColumn Header="Correo" Binding="{Binding correo_electronico_empleado}" Width="150"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding rol_empleado}" Width="100"/>
                                <DataGridTextColumn Header="Salario" Binding="{Binding salario_empleado}" Width="100"/>
                                <DataGridTextColumn Header="Fecha Contrato" Binding="{Binding fecha_inicio_contrato}" Width="120"/>
                                <DataGridTextColumn Header="Hora Entrada" Binding="{Binding hora_entrada_empleado}" Width="100"/>
                                <DataGridTextColumn Header="Hora Salida" Binding="{Binding hora_salida_empleado}" Width="100"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding estado_empleado}" Width="80"/>
                                <DataGridTextColumn Header="Fecha Fin" Binding="{Binding fecha_fin_contrato}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Botones -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                            Height="40" Width="120" FontWeight="Bold" 
                            HorizontalAlignment="Left" Grid.Column="0"
                            Click="btn_Cancelar_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                        <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                                Height="40" Width="120" FontWeight="Bold" Margin="0,0,10,0"
                                Click="btn_Guardar_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="btn_Modificar" Content="Modificar" Background="#1976D2" Foreground="White"
                                Height="40" Width="120" FontWeight="Bold"
                                Click="btn_Modificar_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>