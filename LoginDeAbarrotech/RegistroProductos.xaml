<Window x:Class="LoginDeAbarrotech.RegistroProductos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroProductos" Height="680" Width="1300">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="2.5"/>
                <GradientStop Color="#42A5F5" Offset="5.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!--Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <!-- Título -->
                <TextBlock Text="Registro de Productos" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,0,0,0"/>

                <!-- Campos del formulario -->

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Width="350" Margin="20,0,0,0">
                    <StackPanel>


                        <!-- Nombre -->
                        <TextBlock Text="Nombre" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_Nombre" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Cantidad -->
                        <TextBlock Text="Categoria" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_Categoria" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Precio de Venta -->
                        <TextBlock Text="Precio de Venta" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_PrecioVenta" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Precio de Compra -->
                        <TextBlock Text="Precio de Compra" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_PrecioCompra" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Presentación -->
                        <TextBlock Text="Presentación" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_Presentacion" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Unidad de Medida (ComboBox) -->
                        <TextBlock Text="Unidad de Medida" Foreground="#424242" Margin="5,0,0,3"/>
                        <ComboBox x:Name="cb_UnidadMedida" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2">
                            <ComboBoxItem Content="Kg"/>
                            <ComboBoxItem Content="Gr"/>
                            <ComboBoxItem Content="L"/>
                            <ComboBoxItem Content="Ml"/>
                        </ComboBox>

                        <!-- Marca -->
                        <TextBlock Text="Marca" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_Marca" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- ID de Proveedor -->
                        <TextBlock Text="Id de provedor" Foreground="#424242" Margin="5,0,0,3"/>
                        <ComboBox x:Name="cb_IdProvedor" Margin="0,0,0,15" Height="45" Padding="10"
                            BorderBrush="#1976D2" BorderThickness="2">
                            <!-- Hay que rellenar con los IDs de los provedores obtenidos de la base de datos-->
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!--Tabla de productos-->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Padding="10" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="700" Height="365" Margin="0,50,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="527*"/>
                            <ColumnDefinition Width="151*"/>
                        </Grid.ColumnDefinitions>
                        <!--Titulo-->
                        <TextBlock Text="Lista de Productos" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="678"/>

                        <!-- Datagrid para mostrar los productos-->
                        <DataGrid x:Name="dg_Productos" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0,30,0,-49" Grid.ColumnSpan="2" SelectionChanged="dg_Productos_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id_producto}" Width="40"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding nombre_producto}" Width="200"/>
                                <DataGridTextColumn Header="Marca" Binding="{Binding marca_producto}" Width="120"/>
                                <DataGridTextColumn Header="Presentacion" Binding="{Binding presentacion_producto}" Width="120"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding categoria_producto}" Width="100"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding estado_producto}" Width="100"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Botones -->
                <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                        Height="40" Width="120" FontWeight="Bold" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="420,0,0,32" Click="btn_Cancelar_Click"/>


                <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                        Height="40" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,456,32" Click="btn_Guardar_Click"/>

                <Button x:Name="btn_Modificar" Content="Modificar" Background="#1976D2"  Foreground="White"
                        Height="40" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,310,32" Click="btn_Modificar_Click"/>

                <Button x:Name="btn_Estado" Content="Habilitar/Inhabilitar" Background="#FFC40C"  Foreground="White"
                        Height="40" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,165,32" Click="btn_Estado_Click"/>

                <Label x:Name="Lbl_mensaje" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Green" Content="Producto agregado correctamente" Margin="890,-8,0,0" Width="264" RenderTransformOrigin="0.505,0.579" Height="32" Visibility="Hidden"/>
            </Grid>
        </Border>
    </Grid>
</Window>