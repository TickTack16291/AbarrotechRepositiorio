<Window x:Class="LoginDeAbarrotech.RegistroProveedores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroProveedores" Height="680" Width="1300">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="2.5"/>
                <GradientStop Color="#42A5F5" Offset="5.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!--Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <!-- Título -->
                <TextBlock Text="Registro de Proveedores" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,0,0,0"/>

                <!-- Campos del formulario -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left"
                              VerticalAlignment="Center" Width="350" Margin="20,0,0,0">
                    <StackPanel>
                        
                        <!-- Nombre -->
                        <TextBlock Text="Nombre" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_NombreProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Responsable -->
                        <TextBlock Text="Responsable" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_ResponsableProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Dirección -->
                        <TextBlock Text="Dirección" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_DireccionProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Teléfono -->
                        <TextBlock Text="Teléfono" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_TelefonoProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Email -->
                        <TextBlock Text="Email" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_EmailProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                        <!-- Estado -->
                        <TextBlock Text="Estado" Foreground="#424242" Margin="5,0,0,3"/>
                        <ComboBox x:Name="cb_EstadoProveedor" Margin="0,0,0,15" Height="45" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2">
                            <ComboBoxItem Content="Activo" Tag="1"/>
                            <ComboBoxItem Content="Inactivo" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>

                <!--Tabla de proveedores-->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Padding="10" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Width="700" Height="365" Margin="0,50,20,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="527*"/>
                            <ColumnDefinition Width="151*"/>
                        </Grid.ColumnDefinitions>
                        <!--Titulo-->
                        <TextBlock Text="Lista de Proveedores" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="678"/>

                        <!-- Datagrid para mostrar los proveedores-->
                        <DataGrid x:Name="dg_Proveedores" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0,30,0,-49" Grid.ColumnSpan="2" SelectionChanged="dg_Proveedores_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id_proveedor}" Width="40"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding nombre_proveedor}" Width="180"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding responsable_proveedor}" Width="150"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding telefono_proveedor}" Width="100"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding email_proveedor}" Width="150"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding estado_proveedor}" Width="80"/>
                            </DataGrid.Columns>

                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Botones -->
                <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                        Height="40" Width="120" FontWeight="Bold" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="420,0,0,32" Click="btn_Cancelar_Click"/>

                <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                        Height="40" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,456,32" Click="btn_Guardar_Click"/>

                <Button x:Name="btn_Modificar" Content="Modificar" Background="#1976D2"  Foreground="White"
                        Height="40" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,310,32" Click="btn_Modificar_Click"/>

                <Label x:Name="Lbl_mensaje" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Green" Content="Proveedor agregado correctamente" Margin="890,-8,0,0" Width="264" RenderTransformOrigin="0.505,0.579" Height="32" Visibility="Hidden"/>
            </Grid>
        </Border>
    </Grid>
</Window>