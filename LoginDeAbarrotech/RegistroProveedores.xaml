<Window x:Class="LoginDeAbarrotech.RegistroProveedores"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroProveedores" Height="680" Width="1300">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="2.5"/>
                <GradientStop Color="#42A5F5" Offset="5.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <!-- Layout principal: Título, Formulario, Tabla, Botones -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><!-- Título -->
                    <RowDefinition Height="Auto"/><!-- Formulario -->
                    <RowDefinition Height="*"/><!-- Tabla -->
                    <RowDefinition Height="Auto"/><!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Registro de Proveedores" FontSize="22" FontWeight="Bold" 
                               Foreground="#1565C0" HorizontalAlignment="Center"/>
                    <Label x:Name="Lbl_mensaje"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="Green"
                           Content="Proveedor agregado correctamente"
                           Visibility="Hidden"/>
                </Grid>

                <!-- Formulario (sin ScrollViewer) -->
                <Grid Grid.Row="1" Margin="0,20,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fila 1 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,0,10,10">
                        <TextBlock Text="Nombre" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_NombreProveedor" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,10">
                        <TextBlock Text="Responsable" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_ResponsableProveedor" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,10,10">
                        <TextBlock Text="Dirección" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_DireccionProveedor" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="10,0,10,10">
                        <TextBlock Text="Teléfono" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_TelefonoProveedor" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Fila 2 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,0,10,0">
                        <TextBlock Text="Email" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_EmailProveedor" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,10,0">
                        <TextBlock Text="Estado" Foreground="#424242" Margin="5,0,0,3"/>
                        <ComboBox x:Name="cb_EstadoProveedor" Height="45" Padding="10"
                                  BorderBrush="#1976D2" BorderThickness="2">
                            <ComboBoxItem Content="Activo" Tag="1"/>
                            <ComboBoxItem Content="Inactivo" Tag="0"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Tabla de proveedores -->
                <Border Grid.Row="2"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Padding="10">
                    <Grid>
                        <TextBlock Text="Lista de Proveedores" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,8" VerticalAlignment="Top"/>

                        <DataGrid x:Name="dg_Proveedores" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0,30,0,0"
                                  SelectionChanged="dg_Proveedores_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id_proveedor}" Width="40"/>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding nombre_proveedor}" Width="300"/>
                                <DataGridTextColumn Header="Responsable" Binding="{Binding responsable_proveedor}" Width="300"/>
                                <DataGridTextColumn Header="Teléfono" Binding="{Binding telefono_proveedor}" Width="180"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding email_proveedor}" Width="230"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding estado_proveedor}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Botones -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                            Height="40" Width="120" FontWeight="Bold" 
                            HorizontalAlignment="Left" Grid.Column="0"
                            Click="btn_Cancelar_Click"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" >
                        <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                                Height="40" Width="120" FontWeight="Bold" Margin="0,0,10,0"
                                Click="btn_Guardar_Click"/>
                        <Button x:Name="btn_Modificar" Content="Modificar" Background="#1976D2" Foreground="White"
                                Height="40" Width="120" FontWeight="Bold"
                                Click="btn_Modificar_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>