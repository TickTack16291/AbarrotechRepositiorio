<Window x:Class="LoginDeAbarrotech.RegistroUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroUsuarios" Height="500" Width="500">
    <Grid>
        <Border Background="White" CornerRadius="20" Padding="30" Width="400" Height="420"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>
            <Grid>
                <!-- Título -->
                <TextBlock Text="Registro de Usuarios" FontSize="22" FontWeight="Bold" 
                           Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,0,0,0"/>

                <StackPanel Margin="0,40,0,0">
                    <!-- ID Empleado -->
                    <TextBlock Text="ID Empleado" Foreground="#424242" Margin="5,0,0,3"/>
                    <TextBox x:Name="ct_IdEmpleado" Margin="0,0,0,15" Height="35" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                    <!-- Usuario -->
                    <TextBlock Text="Usuario" Foreground="#424242" Margin="5,0,0,3"/>
                    <TextBox x:Name="ct_Usuario" Margin="0,0,0,15" Height="35" Padding="10"
                             BorderBrush="#1976D2" BorderThickness="2"/>

                    <!-- Contraseña -->
                    <TextBlock Text="Contraseña" Foreground="#424242" Margin="5,0,0,3"/>
                    <PasswordBox x:Name="ct_Contrasena" Margin="0,0,0,15" Height="35" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>

                    <!-- Rol de Usuario -->
                    <TextBlock Text="Rol de Usuario" Foreground="#424242" Margin="5,0,0,3"/>
                    <ComboBox x:Name="cb_RolUsuario" Margin="0,0,0,15" Height="35" Padding="10"
                              BorderBrush="#1976D2" BorderThickness="2">
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Vendedor"/>
                    </ComboBox>
                </StackPanel>

                <!-- Botones -->
                <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                        Height="35" Width="120" FontWeight="Bold" 
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="25,0,0,0" Click="btn_Cancelar_Click"/>

                <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                        Height="35" Width="120" FontWeight="Bold"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,23,0" Click="btn_Guardar_Click"/>

                <Label x:Name="Lbl_mensaje" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="Green" Content="" Margin="0,293,0,0" Width="264" Height="32" Visibility="Hidden"/>
            </Grid>
        </Border>
    </Grid>
</Window>