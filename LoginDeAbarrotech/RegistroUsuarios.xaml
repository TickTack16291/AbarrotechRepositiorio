<Window x:Class="LoginDeAbarrotech.RegistroUsuarios"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="RegistroUsuarios" Height="680" Width="1300" WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="0"/>
                <GradientStop Color="#42A5F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <!-- Layout principal: Título, Formulario, Tabla, Botones -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="Auto"/>
                    <!-- Formulario -->
                    <RowDefinition Height="*"/>
                    <!-- Tabla -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Registro de Usuarios" FontSize="22" FontWeight="Bold" 
                               Foreground="#1565C0" HorizontalAlignment="Center" />
                    <Label x:Name="Lbl_mensaje"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="Green"
                           Content=""
                           Visibility="Hidden"/>
                </Grid>

                <!-- Formulario -->
                <Grid Grid.Row="1" Margin="0,20,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ID Empleado -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,0,10,10">
                        <TextBlock Text="ID Empleado" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_IdEmpleado" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Usuario -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,10">
                        <TextBlock Text="Usuario" Foreground="#424242" Margin="5,0,0,3"/>
                        <TextBox x:Name="ct_Usuario" Height="45" Padding="10"
                                 BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                    <!-- Contraseña -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,10,10">
                        <TextBlock Text="Contraseña" Foreground="#424242" Margin="5,0,0,3"/>
                        <PasswordBox x:Name="ct_Contrasena" Height="45" Padding="10"
                                     BorderBrush="#1976D2" BorderThickness="2"/>
                    </StackPanel>

                </Grid>

                <!-- Tabla de usuarios -->
                <Border Grid.Row="2"
                        Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                        CornerRadius="5" Padding="10">
                    <Grid>
                        <TextBlock Text="Lista de Usuarios" FontSize="16" FontWeight="Bold" 
                                   Foreground="#1565C0" Margin="0,0,0,8" VerticalAlignment="Top"/>

                        <DataGrid x:Name="dg_Usuarios" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  BorderBrush="#E0E0E0" BorderThickness="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Margin="0,30,0,0"
                                  SelectionChanged="dg_Usuarios_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding id_usuario}" Width="60"/>
                                <DataGridTextColumn Header="ID Empleado" Binding="{Binding id_empleado}" Width="120"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding usuario}" Width="200"/>
                                <DataGridTextColumn Header="Rol" Binding="{Binding rol_usuario}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Botones -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_Cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                            Height="40" Width="120" FontWeight="Bold" 
                            HorizontalAlignment="Left" Grid.Column="0"
                            Click="btn_Cancelar_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btn_Guardar" Content="Guardar" Background="#4CAF50" Foreground="White"
                                Height="40" Width="120" FontWeight="Bold" Margin="0,0,10,0"
                                Click="btn_Guardar_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>