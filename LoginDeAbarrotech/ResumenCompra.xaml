<Window x:Class="LoginDeAbarrotech.ResumenCompra"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de la Compra"
        Height="460"
        Width="560"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="#1565C0"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="RoundedInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#401565C0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <!-- Tarjeta principal -->
        <Border Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="16">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <TextBlock Grid.Row="0"
                           Text="Resumen de la Compra"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Datos generales y totales (compacto) -->
                <Border Grid.Row="1"
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Usuario:" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,87,0"/>
                        <TextBlock Name="txt_usuario" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242" Margin="58,0,19,0" Grid.ColumnSpan="2"/>

                        <TextBlock Text="Fecha y hora:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,70,0"/>
                        <TextBlock Name="txt_FechaHora" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242" Margin="75,0,19,0" Grid.ColumnSpan="2" Grid.Row="1"/>

                        <TextBlock Text="Método de pago:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Foreground="#424242" Margin="0,0,37,0"/>
                        <ComboBox 
                                  Name="cb_metodoPago"
                                  Grid.Row="3"
                                  MinWidth="160"
                                  BorderBrush="#1976D2"
                                  BorderThickness="2"
                                  Margin="0,3,70,49"
                                  Grid.ColumnSpan="2">
                            <!-- Métodos de pago agregados -->
                            <ComboBoxItem Content="Efectivo"/>
                            <ComboBoxItem Content="Tarjeta de crédito"/>
                            <ComboBoxItem Content="Tarjeta de débito"/>
                            <ComboBoxItem Content="Transferencia bancaria"/>
                            <ComboBoxItem Content="Cheque"/>
                            <ComboBoxItem Content="Vale"/>
                            <ComboBoxItem Content="Pago mixto"/>
                            <ComboBoxItem Content="Otros"/>
                        </ComboBox>

                        <TextBlock Text="Caja:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Foreground="#424242" Margin="0,31,97,0"/>
                        <TextBlock Name="txt_caja" Grid.Column="0" VerticalAlignment="Top" Foreground="#424242" Margin="35,31,42,0" Grid.ColumnSpan="2" Grid.Row="3"/>

                        <TextBlock Text="Productos distintos:" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,28,0"/>
                        <TextBlock Name="txt_distintos" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242" Margin="112,0,13,0" Grid.ColumnSpan="2"/>
                        <TextBlock Text="Unidades totales:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242" Margin="0,0,37,0"/>
                        <TextBlock Name="txt_productosTotales" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242" Margin="108,0,17,0" Grid.ColumnSpan="2" Grid.Row="1"/>

                        <TextBlock Text="Total:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" Foreground="#424242" Margin="0,31,102,0" Height="16"/>
                        <TextBlock Name="txt_Total" Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" Foreground="#424242" Margin="43,31,34,0" Height="16" Grid.ColumnSpan="2"/>
                        <Label Name="Lbl_mensaje" Foreground="Red" Visibility="Hidden" Content="Debe seleccionar un metodo de pago" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Margin="2,49,0,0" Grid.Row="3" VerticalAlignment="Center" RenderTransformOrigin="-1.009,2.654" Width="474" Grid.ColumnSpan="4"/>

                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,10,0,10"
                        Padding="8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DataGrid ItemsSource="{Binding Items}"
                              Name="dg_resumenVenta"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#E0E0E0" BorderThickness="1"
                              RowHeaderWidth="0" Margin="0,1,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding nombre_producto}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding cantidad}" Width="60"/>
                            <DataGridTextColumn Header="P.Unit." Binding="{Binding precio_compra_producto, StringFormat=C}" Width="90"/>
                            <DataGridTextColumn Header="Subtotal"
                                                Binding="{Binding Subtotal, StringFormat={}{0:C}}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">
                    <Button Content="Cancelar"
                            Width="110"
                            Margin="0,0,8,0"
                            Background="#E53935"
                            Style="{StaticResource RoundedButtonStyle}" Click="Button_Click_Cancelar"/>
                    <Button Content="Confirmar"
                            Width="140"
                            FontWeight="Bold"
                            Background="#4CAF50"
                            Style="{StaticResource RoundedButtonStyle}" Click="Button_Click_Confirmar"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>