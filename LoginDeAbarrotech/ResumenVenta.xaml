<Window x:Class="LoginDeAbarrotech.ResumenVenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resumen de la Venta"
        Height="460"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="#F5F5F5">
    <Window.Resources>
        <!-- Botón con esquinas redondeadas (coherente con Compras) -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- TextBox redondeado similar al estilo de búsqueda en Compras -->
        <Style x:Key="RoundedInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#401565C0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <!-- Tarjeta principal (coherente con tarjetas del dashboard) -->
        <Border Background="White"
                CornerRadius="12"
                Padding="16"
                Margin="16">
            <Border.Effect>
                <DropShadowEffect Color="#40000000" BlurRadius="10" ShadowDepth="3"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado -->
                <TextBlock Grid.Row="0"
                           Text="Resumen de la Venta"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#1565C0"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Datos generales y totales (compacto) -->
                <Border Grid.Row="1"
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Izquierda: usuario, fecha, pago, caja -->
                        <TextBlock Text="Usuario:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242"/>
                        <TextBlock Text="{Binding Usuario}" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold"/>

                        <TextBlock Text="Fecha y hora:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242"/>
                        <TextBlock Text="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Método de pago:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Foreground="#424242"/>
                        <ComboBox Grid.Row="2"
                                  ItemsSource="{Binding MetodosPago}"
                                  SelectedItem="{Binding MetodoPagoSeleccionado}"
                                  MinWidth="160"
                                  BorderBrush="#1976D2" BorderThickness="2" Margin="0,16,70,19" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

                        <TextBlock Text="Caja:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#424242"/>

                        <!-- Derecha: totales compactos -->
                        <TextBlock Text="Productos distintos:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242"/>
                        <TextBlock Text="{Binding CantidadProductos}" Grid.Row="0" Grid.Column="3"/>

                        <TextBlock Text="Unidades totales:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Foreground="#424242"/>
                        <TextBlock Text="{Binding UnidadesTotales}" Grid.Row="1" Grid.Column="3"/>

                        <TextBlock Text="Total:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" Foreground="#424242" Margin="0,8,0,0"/>
                        <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Text="{Binding Total, StringFormat=C}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#2E7D32"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detalle de productos (compacto) -->
                <Border Grid.Row="2"
                        Margin="0,10,0,10"
                        Padding="8"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="8">
                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="#E0E0E0" BorderThickness="1"
                              RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="60"/>
                            <DataGridTextColumn Header="P.Unit." Binding="{Binding PrecioUnitario, StringFormat=C}" Width="90"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Botones (sin eventos) -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0"
                            >
                    <Button Content="Cancelar"
                            Width="110"
                            Margin="0,0,8,0"
                            Background="#E53935"
                            Style="{StaticResource RoundedButtonStyle}" Click="Button_Click"/>
                    <Button Content="Confirmar"
                            Width="140"
                            FontWeight="Bold"
                            Background="#4CAF50"
                            Style="{StaticResource RoundedButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>