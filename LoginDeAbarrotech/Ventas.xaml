<Window x:Class="LoginDeAbarrotech.Ventas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDeAbarrotech"
        mc:Ignorable="d"
        Title="Ventas" Height="680" Width="1300" WindowStartupLocation="CenterScreen">

    <!-- Estilo para redondear la caja de búsqueda -->
    <Window.Resources>
        <Style x:Key="RoundedSearchTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="#401565C0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Fondo -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1976D2" Offset="0"/>
                <GradientStop Color="#42A5F5" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Contenedor principal -->
        <Border Background="White" CornerRadius="20" Padding="30" Width="1200" Height="598"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5"/>
            </Border.Effect>

            <!-- Layout principal: Título, Filtros, Listas, Botones -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Título -->
                    <RowDefinition Height="Auto"/>
                    <!-- Filtros -->
                    <RowDefinition Height="*"/>
                    <!-- Listas -->
                    <RowDefinition Height="Auto"/>
                    <!-- Botones -->
                </Grid.RowDefinitions>

                <!-- Título -->
                <Grid Grid.Row="0">
                    <TextBlock Text="Ventas" FontSize="22" FontWeight="Bold"
                               Foreground="#1565C0" HorizontalAlignment="Center"/>
                </Grid>

                <!-- Filtros -->
                <Grid Grid.Row="1" Margin="0,20,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Categoría:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#424242"/>
                    <ComboBox x:Name="cb_categorias" Grid.Column="1" Height="38" Padding="10"
                              BorderBrush="#1976D2" BorderThickness="2" SelectedIndex="0">
                        <ComboBoxItem Content="Todas" IsSelected="True"/>
                        <!-- categorias, erick queria que se pudieran agregar desde la interfaz, pero me dio flojera jaja -->
                        <!-- talvez despues -->
                        <ComboBoxItem Content="Bebidas"/>
                        <ComboBoxItem Content="Lácteos"/>
                        <ComboBoxItem Content="Botanas"/>
                        <ComboBoxItem Content="Enlatados"/>
                        <ComboBoxItem Content="Cereales"/>
                        <ComboBoxItem Content="Galletas"/>
                        <ComboBoxItem Content="Panadería"/>
                        <ComboBoxItem Content="Condimentos"/>
                        <ComboBoxItem Content="Congelados"/>
                        <ComboBoxItem Content="Aceites"/>
                        <ComboBoxItem Content="Granos"/>
                    </ComboBox>

                    <TextBox x:Name="txt_busqueda" Grid.Column="3" Height="38"
                             BorderBrush="#1976D2" BorderThickness="2"
                             ToolTip="Buscar por nombre (coincidencia parcial)"
                             Style="{StaticResource RoundedSearchTextBox}"/>
                    <Button x:Name="btn_filtrar" Grid.Column="4" Content="Buscar"
                            Height="32" Width="96" Foreground="White" Background="#1976D2">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="btl_LimpiarFiltro" Grid.Column="6" Content="Limpiar"
                            Height="32" Width="96" Foreground="White" Background="#1565C0">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Listas principales -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Productos disponibles -->
                    <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="5" Padding="10">
                        <Grid>
                            <TextBlock Text="Productos disponibles" FontSize="16" FontWeight="Bold"
                                       Foreground="#1565C0" Margin="0,0,0,8" VerticalAlignment="Top"/>
                            <ListView x:Name="dg_ProductosDisponibles" Margin="0,30,0,0"
                                      SelectionMode="Single"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.ScrollUnit="Item">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="id" Width="50" DisplayMemberBinding="{Binding id_producto}" />
                                        <GridViewColumn Header="Nombre" Width="240" DisplayMemberBinding="{Binding nombre_producto}" />
                                        <GridViewColumn Header="Categoría" Width="150" DisplayMemberBinding="{Binding categoria_producto}" />
                                        <GridViewColumn Header="Precio" Width="100" DisplayMemberBinding="{Binding precio_venta_producto}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Precio, StringFormat={}{0:C}}"
                                                               TextAlignment="Right"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Stock" Width="90" DisplayMemberBinding="{Binding Stock}" />
                                        <GridViewColumn Header="Acciones" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Agregar" x:Name="AddToSelectedButton"
                                                            Height="30" Width="100" Foreground="White" Background="#1976D2">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Separador -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- Productos seleccionados -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="5" Padding="10">
                        <Grid>
                            <TextBlock Text="Productos seleccionados para la venta" FontSize="16" FontWeight="Bold"
                                       Foreground="#1565C0" Margin="0,0,0,8" VerticalAlignment="Top"/>
                            <ListView x:Name="dg_ProductosSeleecionados" Margin="0,30,0,0"
                                      SelectionMode="Single"
                                      ScrollViewer.CanContentScroll="True"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.ScrollUnit="Item">
                                <ListView.View>
                                    <GridView AllowsColumnReorder="False">
                                        <GridViewColumn Header="id" Width="50" DisplayMemberBinding="{Binding id_producto}" />
                                        <GridViewColumn Header="Nombre" Width="240" DisplayMemberBinding="{Binding nombre_productp}" />
                                        <GridViewColumn Header="Categoría" Width="150" DisplayMemberBinding="{Binding categoria_producto}" />
                                        <GridViewColumn Header="Precio" Width="100" DisplayMemberBinding="{Binding precio_venta_producto}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Cant.:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ComboBox Width="80" x:Name="QuantityComboBox" SelectedIndex="0"
                                                                  BorderBrush="#1976D2" BorderThickness="2">
                                                            <ComboBoxItem Content="1" IsSelected="True"/>
                                                            <ComboBoxItem Content="2"/>
                                                            <ComboBoxItem Content="3"/>
                                                            <ComboBoxItem Content="4"/>
                                                            <ComboBoxItem Content="5"/>
                                                            <ComboBoxItem Content="6"/>
                                                            <ComboBoxItem Content="7"/>
                                                            <ComboBoxItem Content="8"/>
                                                            <ComboBoxItem Content="9"/>
                                                            <ComboBoxItem Content="10"/>
                                                            <ComboBoxItem Content="11"/>
                                                            <ComboBoxItem Content="12"/>
                                                            <ComboBoxItem Content="13"/>
                                                            <ComboBoxItem Content="14"/>
                                                            <ComboBoxItem Content="15"/>
                                                            <ComboBoxItem Content="16"/>
                                                            <ComboBoxItem Content="17"/>
                                                            <ComboBoxItem Content="18"/>
                                                            <ComboBoxItem Content="19"/>
                                                            <ComboBoxItem Content="20"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Acciones" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Eliminar" x:Name="RemoveFromSelectedButton"
                                                            Height="30" Width="100" Foreground="White" Background="#E53935">
                                                        <Button.Style>
                                                            <Style TargetType="{x:Type Button}">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Botones inferiores + Total -->
                <Grid Grid.Row="3" Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btn_cancelar" Content="Cancelar" Background="#E53935" Foreground="White"
                            Height="40" Width="160" FontWeight="Bold" HorizontalAlignment="Left" Grid.Column="0" Click="btn_cancelar_Click_1">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#F5F5F5" CornerRadius="8" Padding="12,8" Margin="0,0,10,0"
                                BorderBrush="#E0E0E0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total:" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,8,0"/>
                                <TextBlock x:Name="Txt_TotalVenta" Text="$0.00"
                                           FontWeight="Bold" Foreground="#2E7D32"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btn_RealizarVenta" Content="Realizar venta" Background="#4CAF50" Foreground="White"
                                Height="40" Width="160" FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>